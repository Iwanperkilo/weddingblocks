{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "weddingblocks/couple-photo",
  "title": "WB Foto Mempelai",
  "category": "weddingblocks",
  "icon": "format-image",
  "description": "Menampilkan foto mempelai pria atau wanita dengan gaya bentuk melingkar atau persegi.",
  "textdomain": "weddingblocks",
  "attributes": {
    "groomPhoto": {
      "type": "string"
    },
    "bridePhoto": {
      "type": "string"
    },
    "groomName": {
      "type": "string"
    },
    "brideName": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "default": "groom"
    },
    "shape": {
      "type": "string",
      "default": "circle"
    },
    "size": {
      "type": "number",
      "default": 200
    },
    "showFrame": {
      "type": "boolean",
      "default": true
    },
    "frameColor": {
      "type": "string",
      "default": ""
    },
    "frameWidth": {
      "type": "number",
      "default": 3
    },
    "align": {
      "type": "string",
      "default": "center"
    },
    "animationStyle": {
      "type": "string",
      "default": "zoomIn"
    },
    "animationDuration": {
      "type": "number",
      "default": 600
    },
    "animationDelay": {
      "type": "number",
      "default": 0
    },
    "photoFocalPoint": {
      "type": "object",
      "default": { "x": 0.5, "y": 0.5 }
    },
    "photoZoom": {
      "type": "number",
      "default": 100
    }
  },
  "supports": {
    "html": false,
    "spacing": {
      "margin": true,
      "padding": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true,
      "__experimentalSkipSerialization": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true,
      "__experimentalSkipSerialization": true
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php",
  "style": ["weddingblocks-frontend-style", "weddingblocks-atomic-style"],
  "script": "weddingblocks-frontend-script"
}
